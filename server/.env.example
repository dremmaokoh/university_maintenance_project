PORT=5000
# Include database name before ? (e.g. university_maintenance), not only the cluster host.
# Use npm run dev (not dev:preview) for Atlas. Restart the server after changing this file.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@cluster0.example.mongodb.net/university_maintenance?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
INVITE_EXPIRY_DAYS=7

# Cloudinary (request evidence uploads — required for the API)
# Cloudinary (evidence files). API key must allow Upload API (create assets), not Admin-only.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Legacy local evidence files (pre-Cloudinary) may still exist under server/uploads/evidence.

# Local MongoDB example:
# MONGODB_URI=mongodb://127.0.0.1:27017/university_maintenance

# Local dev without MongoDB: npm run dev:preview (in-memory DB; restart to clear data)
# With MongoDB: npm run db:reset -- --confirm  (or: node src/scripts/resetDatabase.js --confirm)
